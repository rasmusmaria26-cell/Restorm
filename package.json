{
  "name": "retry-storm-sentinel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "build": "cds build --production",
    "test": "node --test --test-concurrency=1 test/**/*.test.js",
    "test:cpi": "node scripts/simulate-cpi.js"
  },
  "dependencies": {
    "@langchain/core": "^1.3.2",
    "@sap/cds": "^9",
    "body-parser": "^2.4.0",
    "express": "^5.3.0",
    "langchain": "^1.6.0",
    "langsmith": "^0.11.5",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.6"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@playwright/test": "^1.64.1",
    "@sap/cds-dk": "^9.9.7"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": {
            "roles": [
              "SupportViewer"
            ]
          },
          "bob": {
            "roles": [
              "SupportOperator",
              "SupportViewer"
            ]
          },
          "admin": {
            "roles": [
              "SimulatorAdmin",
              "SupportOperator",
              "SupportViewer"
            ]
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    },
    "server": {
      "middleware": {
        "before": [
          "srv/security-headers.js"
        ]
      }
    }
  }
}
