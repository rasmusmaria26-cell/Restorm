# ==============================================================================
# Retry Storm Sentinel — Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and insert your API keys:
#   copy .env.example .env

# Option 1: OpenRouter API (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Recommended free models on OpenRouter (no deposit needed):
# - nvidia/nemotron-3.5-lightning:free
# - minimax/minimax-m3.1-flash:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Option 2: Direct Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=4004

# ==============================================================================
# Restorm AI Orchestration & Observability (Optional)
# ==============================================================================
# AI orchestration mode: 'legacy' (default) or 'langchain'
RESTORM_AI_ORCHESTRATION=legacy

# LangSmith observability controls (disabled by default)
RESTORM_LANGSMITH_ENABLED=false
RESTORM_LANGSMITH_CAPTURE_CONTENT=false
RESTORM_LANGSMITH_EVAL_UPLOAD=false

# LangSmith official SDK environment variables
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=restorm-ai-development
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
